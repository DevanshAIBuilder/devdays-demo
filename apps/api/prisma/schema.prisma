generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Meetup {
  id          Int    @id @default(autoincrement())
  title       String
  date        String
  description String
  rsvps       Rsvp[]
}

model Rsvp {
  id       Int    @id @default(autoincrement())
  meetupId Int
  name     String
  email    String
  meetup   Meetup @relation(fields: [meetupId], references: [id])
}
